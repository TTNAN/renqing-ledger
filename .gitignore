# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-single/
*.local
release/
release-android/

# 单文件发行版（由 pnpm build:single 生成，不入库）
人情账.html

# 图标与启动图的生成结果（由 pnpm icons / build:all 生成，不入库）。
# 原料在 assets/icons/source/，那里才是要提交的东西 ——
# 有原料就能随时重新生成，把生成结果提交进去只会让 diff 变脏。
android-res/
public/
build/icon.ico
build/icon.png
build/icon-512.png

# 注意：build/installer.nsh 是手写的（卸载时询问是否删数据），
# 被 electron-builder.yml 引用，必须保留，所以不忽略整个 build/。

# 图标素材的临时解压目录。
# 注意：正式素材在 assets/icons/source/，那个要入库 ——
# 别人 clone 之后得能重新生成各平台图标。
.icons-extract/
icons_*.zip

# ---------------------------------------------------------------------------
# 签名密钥 —— 绝对不能进仓库
# ---------------------------------------------------------------------------
*.jks
*.keystore
keystore.properties
android/keystore.properties
android/local.properties
android/app/release/

# Android 构建产物
android/app/build/
android/build/
android/.gradle/
android/capacitor-cordova-android-plugins/build/
.gradle/

# 测试与缓存
coverage/
.vite/
*.tsbuildinfo
e2e-shots/

# 测试用的临时目录与浏览器 profile。
# 用通配符而不是逐个列名字 —— 每加一个 E2E 脚本就会多一个目录，列名字必漏。
.*-profile/
.*-stage/
.img-convert.html
.icon-analyze.html
.android-*/
.repro*/
.verify-*/
.diag-*/

# 本地备份（含真实姓名与金额，绝不能进仓库）
backups/
*.ledger.json

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
